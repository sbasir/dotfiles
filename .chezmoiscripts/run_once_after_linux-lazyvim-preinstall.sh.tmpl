{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Preinstall LazyVim plugins + treesitter parsers in headless mode so the
# first interactive `nvim` on a fresh instance (e.g. a newly-baked AMI or a
# brand-new VM) skips the annoying "installing plugins..." screen.
#
# run_once_after_*: fires after file operations in `chezmoi apply`, so the
# .chezmoiexternal.toml clone of lazyvim-starter into ~/.config/nvim is in
# place. Hashed by content — re-runs if the script itself changes.
#
# Linux-guarded: on macOS we generally run nvim interactively and want to
# see the plugin sync; on Linux this is always headless provisioning.
#
# Idempotent: Lazy sync is a no-op when plugins are up to date.

set -euo pipefail

if ! command -v nvim >/dev/null 2>&1; then
    echo "[lazyvim-preinstall] nvim not installed — skipping"
    exit 0
fi

NVIM_CONFIG="${HOME}/.config/nvim"
if [ ! -d "${NVIM_CONFIG}" ]; then
    echo "[lazyvim-preinstall] ${NVIM_CONFIG} missing — skipping"
    exit 0
fi

# Known cosmetic warnings from headless nvim + LazyVim + Mason that fire
# even when the final state is good (plugins installed, tools eventually
# available on first interactive use). Silencing so real errors aren't
# lost in the noise.
#
# Patterns:
#   - "Neovim is exiting while packages are still installing" — Mason's
#     auto-install is async; every headless quit trips it even though
#     mason-tool-installer retries on next nvim startup.
#   - "Neovim exited while the following packages were installing" — same.
#   - "- gofumpt" etc. — the follow-up list under the above warning.
#   - "E492: Not an editor command: TSUpdateSync" — LazyVim wraps
#     nvim-treesitter with a lazy load that isn't fully set up in headless
#     mode. Treesitter parsers install on first interactive use instead.
NVIM_NOISE='^(\[mason\.nvim\] Neovim is exiting|\[mason\.nvim\] Neovim exited while|- (gofumpt|goimports|markdown-toc|markdownlint-cli2|shellcheck|sqlfluff|tflint)|Error in command line:|E492: Not an editor command: TSUpdateSync)'

# Runs `nvim --headless "$@"` and filters known cosmetic noise from the
# combined output. Returns nvim's real exit status (PIPESTATUS[0]) so
# genuine failures still propagate through the caller's `if !` check.
run_nvim_filtered() {
    local rc
    { nvim --headless "$@" 2>&1 || true; } | grep -vE "${NVIM_NOISE}" || true
    rc=${PIPESTATUS[0]}
    return "${rc}"
}

echo "[lazyvim-preinstall] Lazy! sync (this may take a few minutes on first run)"
# Lazy! (with the bang) forces non-interactive mode. +qa ensures we exit.
# Lazy sync is idempotent — a no-op when plugins are up to date.
if ! run_nvim_filtered "+Lazy! sync" +qa; then
    echo "[lazyvim-preinstall] Lazy sync reported warnings (non-fatal)"
fi

echo "[lazyvim-preinstall] Installing treesitter parsers"
# LazyVim loads nvim-treesitter lazily on BufRead / BufNewFile, which
# doesn't fire in headless mode, so :TSUpdateSync isn't registered.
# `Lazy! load` pulls the plugin onto the runtimepath; then we call
# nvim-treesitter.install directly via Lua instead of the :TSUpdateSync
# command, which bypasses the user-command registration issue entirely.
# If the require fails (plugin genuinely not installed), pcall returns
# false and we log a warning — parsers install on first interactive use.
if ! run_nvim_filtered \
    "+Lazy! load nvim-treesitter" \
    "+lua local ok, install = pcall(require, 'nvim-treesitter.install'); if ok then install.update({with_sync=true})() else print('nvim-treesitter.install not loadable — skipping') end" \
    +qa; then
    echo "[lazyvim-preinstall] Treesitter update reported warnings (non-fatal)"
fi

# Mason-tool-installer's async downloads (gofumpt, shellcheck, etc.) are
# deliberately NOT waited on here. A previous iteration blocked up to
# 5 minutes on mason-registry polling, but the "is_installing()" API
# doesn't reliably reflect queued state — the warning still fired on exit
# and we paid ~10 min of extra AMI build time for nothing. Mason re-runs
# ensure_installed on first interactive nvim launch, so the tools land
# in place with a small delay the first time the user opens a matching
# filetype. Net: cleaner log, faster AMI build, identical end state.

echo "[lazyvim-preinstall] Done."
{{ end -}}
