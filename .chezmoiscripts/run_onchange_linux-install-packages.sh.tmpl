{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# Suppress debconf TTY-fallback chatter + the "apt has no stable CLI" warning
# when this script runs headless (Packer builds, cloud-init, etc.). No effect
# on interactive runs beyond silencing the same warnings.
# shellcheck disable=SC2034  # exported via env, some tools read it indirectly
export DEBIAN_FRONTEND=noninteractive
export DEBCONF_NONINTERACTIVE_SEEN=true
# Use apt-get (stable CLI, unlike `apt`) with Dpkg::Use-Pty=0 so dpkg doesn't
# try to reopen stdin. Array form keeps shellcheck SC2086 clean when expanded.
APT_GET=(sudo apt-get -o=Dpkg::Use-Pty=0)

echo "=== Installing APT packages ==="
"${APT_GET[@]}" update -q
{{ range .packages.linux.apt_packages -}}
"${APT_GET[@]}" install -y -q {{ . | quote }}
{{ end }}

# --- Locale Fix --- 
DESIRED_LOCALE="${LC_ALL:-${LANG:-C.UTF-8}}"
echo "Using locale: $DESIRED_LOCALE"
"${APT_GET[@]}" install -y -q locales
if ! locale -a | grep -qi "^${DESIRED_LOCALE}$"; then
  echo "Generating locale: $DESIRED_LOCALE" 
  sudo sed -i "s/# ${DESIRED_LOCALE} UTF-8/${DESIRED_LOCALE} UTF-8/" /etc/locale.gen || true 
  echo "${DESIRED_LOCALE} UTF-8" | sudo tee -a /etc/locale.gen >/dev/null 
  sudo locale-gen 
fi

sudo update-locale LANG="$DESIRED_LOCALE" LC_ALL="$DESIRED_LOCALE"

echo "=== Installing Node.js via n ==="

# Install n (Node binary manager)
curl -L https://raw.githubusercontent.com/tj/n/master/bin/n -o n
sudo bash n {{ .packages.linux.node_install.version }}
rm n
# Fix permissions so npm can install global packages 
sudo chown -R $(whoami) /usr/local/bin /usr/local/lib/node_modules 
# Ensure PATH is correct 
export PATH="/usr/local/bin:$PATH"

# Verify installation
echo "Node version: $(node -v)"
echo "npm version: $(npm -v)"

echo "=== Installing npm packages ==="
{{ range .packages.linux.node_install.packages -}}
npm install -g {{ . | quote }}
{{ end }}

echo "=== Installing unattended packages ==="
{{ range .packages.linux.unattended_install -}}
{{ range .command -}}
{{ . }}
{{ end }}
{{ end }}

echo "=== Installing .deb packages ==="
{{ range .packages.linux.deb_install_packages -}}
curl -sL -o {{ .file | quote }} {{ .url | quote }}
"${APT_GET[@]}" install -y -q ./{{ .file | quote }}
rm -f {{ .file | quote }}
{{ end }}

echo "=== Installing AppImage packages ==="
{{ range .packages.linux.appimage_install_packages }}
curl -sL -o {{ .file | quote }} {{ .url | quote }}
chmod +x {{ .file | quote }}
sudo mv {{ .file | quote }} {{ .target | quote }}
{{ end }}

echo "=== Installing tarball packages ==="
{{ range .packages.linux.tar_install_packages }}
echo "Installing from tarball: {{ .url }}"

# Download
curl -sL -o {{ .file | quote }} {{ .url | quote }}

# Prepare target directory
sudo rm -rf {{ .target | quote }}
sudo mkdir -p {{ .target | quote }}

# Extract
sudo tar xzf {{ .file | quote }} -C {{ .target | quote }} --strip-components=1

# Optional symlink
{{ if .symlink }}
sudo ln -sf {{ printf "%s%s" .target .binary | quote }} {{ .symlink | quote }}
{{ end }}

# Cleanup
rm -f {{ .file | quote }}

{{ end }}

{{ end -}}

