# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH="$PATH:$HOME/bin:/usr/local/bin:$HOME/.local/bin"

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

zstyle ':omz:update' mode disabled
plugins=(git gh kubectl kubectx)
source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

source <(chezmoi completion zsh)
export EDITOR=nvim

{{- if eq .chezmoi.os "darwin" }}
export N_PREFIX="$HOME/.n"
export PATH="$N_PREFIX/bin:$PATH"

# Rancher Desktop
export PATH="$PATH:$HOME/.rd/bin"

# Google Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# Claude Code (installed to $HOME/.local/bin)
[[ -d "$HOME/.local/bin" ]] && case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
# pnpm end

# aws auto-completion
complete -C /opt/homebrew/bin/aws_completer aws

if command -v go &> /dev/null; then
  export GOPATH="$HOME/go"
  export PATH="$PATH:$GOPATH/bin"
fi

export CONTEXT7_API_KEY={{ keyring "context7" "api" | quote }}

# Lima/Docker socket — sourced once at shell start
# export DOCKER_HOST="unix://${HOME}/.lima/docker/sock/docker.sock"

# Convenience aliases
alias lstart='limactl start docker'
alias lstop='limactl stop docker'
alias lshell='limactl shell docker'
alias lstatus='limactl list'

source <(colima completion zsh)

# --- Cloudflare WARP TLS-inspection workaround (dynamic precmd guard) ---
# WARP's Gateway CA intercepts outbound HTTPS when the tunnel is UP. AWS
# SDK / pip / npm / go don't consult the macOS keychain, so they reject
# the cert unless pointed at WARP's CA via *_CA_BUNDLE envs. Generate
# the bundle once with `warp-ca` (~/.local/bin/warp-ca).
#
# Check uses `warp-cli status` (not pgrep) so we distinguish all four
# states correctly:
#   - warp-cli not installed         → CA off
#   - warp-cli but daemon down       → CA off (status exits non-zero)
#   - daemon up, user disconnected   → CA off ("Status update: Disconnected")
#   - connected                      → CA on  ("Status update: Connected")
# Cost is ~15ms when daemon is down (fast fail) and similar when up —
# cheap vs the git/segment work p10k already does per prompt.
_warp_ca_guard() {
    local connected=false
    if command -v warp-cli >/dev/null 2>&1 \
        && warp-cli status 2>/dev/null | grep -q "Status update: Connected"; then
        connected=true
    fi
    # Prefer the combined bundle (system Mozilla roots + WARP CA) so tools
    # still trust non-intercepted endpoints (AWS STS/EKS eu-west-1 split-
    # tunnel past WARP and present real Amazon certs). Fall back to the
    # WARP-only file if combined hasn't been built yet.
    local bundle=""
    if $connected; then
        if [[ -f "$HOME/.warp-ca-combined.pem" ]]; then
            bundle="$HOME/.warp-ca-combined.pem"
        elif [[ -f "$HOME/.warp-ca.pem" ]]; then
            bundle="$HOME/.warp-ca.pem"
        fi
    fi
    if [[ -n "$bundle" ]]; then
        export AWS_CA_BUNDLE="$bundle"
        export REQUESTS_CA_BUNDLE="$AWS_CA_BUNDLE"
        export NODE_EXTRA_CA_CERTS="$AWS_CA_BUNDLE"
        export SSL_CERT_FILE="$AWS_CA_BUNDLE"
    else
        unset AWS_CA_BUNDLE REQUESTS_CA_BUNDLE NODE_EXTRA_CA_CERTS SSL_CERT_FILE
    fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _warp_ca_guard
_warp_ca_guard   # run once at shell start so the first command sees it

# p10k custom segment: shows "W" in orange in the right prompt when the
# WARP CA envs are active (i.e. AWS_CA_BUNDLE is set by _warp_ca_guard).
# Put next to the AWS segment so "am I talking to AWS via WARP?" is
# visible at a glance. Insertion is idempotent — guard against double-add
# if .zshrc is sourced again in the same shell.
function prompt_warp_ca() {
    [[ -n "$AWS_CA_BUNDLE" ]] || return
    p10k segment -f 208 -t 'W'
}
function instant_prompt_warp_ca() { prompt_warp_ca }

if (( ${+POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS} )) \
    && [[ -z "${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[(r)warp_ca]}" ]]; then
    typeset -ga POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(
        warp_ca
        "${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[@]}"
    )
fi
{{ end }}
{{- if eq .chezmoi.os "linux" }}
# --- Linux (remote workspace) ---
# pnpm (installed via get.pnpm.io to $HOME/.local/share/pnpm)
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# Claude Code (installed to $HOME/.local/bin)
[[ -d "$HOME/.local/bin" ]] && case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

if command -v go &> /dev/null; then
  export GOPATH="$HOME/go"
  export PATH="$PATH:$GOPATH/bin"
fi

# ssh-agent: load id_ed25519 (restored from SSM by boot-secrets.sh)
if [[ -z "$SSH_AUTH_SOCK" ]] || ! ssh-add -l &>/dev/null; then
  eval "$(ssh-agent -s)" > /dev/null 2>&1
  [[ -f "$HOME/.ssh/id_ed25519" ]] && ssh-add "$HOME/.ssh/id_ed25519" 2>/dev/null
fi

# gnome-keyring: libsecret backend for aws-vault + GitHub Copilot CLI.
# Keyring DB is on S3 Files (symlinked by s3files-mount.sh) so creds survive terminate.
# Empty password — SSH key + SG is the real boundary.
if command -v gnome-keyring-daemon &>/dev/null && [[ -z "$GNOME_KEYRING_CONTROL" ]]; then
  eval "$(gnome-keyring-daemon --start --daemonize --components=secrets 2>/dev/null)"
  export SSH_AUTH_SOCK GNOME_KEYRING_CONTROL
  printf '' | gnome-keyring-daemon --replace --unlock --components=secrets >/dev/null 2>&1 || true
fi
{{ end }}

command -v uv >/dev/null 2>&1 && eval "$(uv generate-shell-completion zsh)"
