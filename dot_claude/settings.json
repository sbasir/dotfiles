{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(*aws-vault exec ba.m2.staging*)",
      "Bash(*aws-vault exec ba.m2.dev*)",
      "Bash(*aws-vault exec ba.uk.legacy*)",
      "Bash(*aws-vault exec ba.fr.prod*)",
      "Bash(*aws-vault exec ba.workloads.staging*)",
      "Bash(*aws-vault exec ba.workloads.staging2*)",
      "Bash(*aws-vault exec ba.infra.networks*)",
      "Bash(*aws-vault exec ba.infra.shared*)",
      "Bash(*aws-vault exec ba.security.keys*)",
      "Bash(*aws-vault exec ba.security.tools*)",
      "Bash(*aws-vault exec ba.it.services*)",
      "Bash(sleep*)",
      "Bash(date*)",
      "Bash(ls /Users/sofy/Library/CloudStorage/**)",
      "Read(/Users/sofy/Library/CloudStorage/**/My Drive/Obsidian/Obsidian Vault v1/work/projects/brandalley/**)",
      "Edit(/Users/sofy/Library/CloudStorage/**/My Drive/Obsidian/Obsidian Vault v1/work/projects/brandalley/**)"
    ],
    "ask": [
      "Bash(*aws-vault exec *prod*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": []
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "coderabbit@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "terraform@claude-plugins-official": false,
    "mintlify@claude-plugins-official": false,
    "aikido@claude-plugins-official": false,
    "grafana-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "feedbackSurveyRate": 0,
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
