#!/bin/sh
# Claude Code status line — mirrors p10k segments: dir, git, model, context window, user@host
# Managed by chezmoi. Edit via: chezmoi edit ~/.claude/statusline-command.sh
input=$(cat)

# --- directory (like p10k dir) ---
cwd=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // empty')
if [ -z "$cwd" ]; then
  cwd="$(pwd)"
fi
home="{{ .chezmoi.homeDir }}"
short_cwd="${cwd/#$home/~}"

# --- git branch (like p10k vcs) ---
git_part=""
branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
if [ -n "$branch" ]; then
  git_part=" \033[0;33m $branch\033[0m"
fi

# --- model ---
model=$(echo "$input" | jq -r '.model.display_name // empty')

# --- context window ---
used_pct=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
ctx_part=""
if [ -n "$used_pct" ]; then
  used_int=$(printf "%.0f" "$used_pct")
  if [ "$used_int" -ge 80 ]; then
    ctx_color="\033[0;31m"
  elif [ "$used_int" -ge 50 ]; then
    ctx_color="\033[0;33m"
  else
    ctx_color="\033[0;32m"
  fi
  ctx_part=" ${ctx_color}ctx:${used_int}%\033[0m"
fi

# --- user@host (like p10k context) ---
user_host="{{ .chezmoi.username }}@{{ .chezmoi.hostname }}"

# --- vim mode (if active) ---
vim_part=""
vim_mode=$(echo "$input" | jq -r '.vim.mode // empty')
if [ -n "$vim_mode" ]; then
  if [ "$vim_mode" = "NORMAL" ]; then
    vim_part=" \033[0;34m[N]\033[0m"
  else
    vim_part=" \033[0;32m[I]\033[0m"
  fi
fi

printf "\033[0;34m%s\033[0m%s%s%s  \033[2m%s\033[0m  \033[2m%s\033[0m" \
  "$short_cwd" \
  "$git_part" \
  "$ctx_part" \
  "$vim_part" \
  "$model" \
  "$user_host"
