#!/bin/bash
# Claude Code status line — two lines:
#   line 1: ccusage (model + spend + burn) — falls back to model name if ccusage is absent
#   line 2: dir, git, ctx, vim, user@host
# Managed by chezmoi. Edit via: chezmoi edit ~/.claude/statusline-command.sh
input=$(cat)

# --- directory (like p10k dir) ---
cwd=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // empty')
if [ -z "$cwd" ]; then
  cwd="$(pwd)"
fi
home="{{ .chezmoi.homeDir }}"
short_cwd="${cwd/#$home/~}"

# --- ANSI color helpers (resolved at runtime, not as literal strings) ---
RESET=$(printf '\033[0m')
YELLOW=$(printf '\033[0;33m')
RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
BLUE=$(printf '\033[0;34m')
DIM=$(printf '\033[2m')

# --- model (used as line-1 fallback if ccusage is absent) ---
model=$(echo "$input" | jq -r '.model.display_name // empty')

# --- git branch (like p10k vcs) ---
git_part=""
branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
if [ -n "$branch" ]; then
  git_part=" ${YELLOW} $branch${RESET}"
fi

# --- context window (Claude Code's reported %, color-coded — preferred over ccusage's 🧠 segment) ---
used_pct=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
ctx_part=""
if [ -n "$used_pct" ]; then
  used_int=$(printf "%.0f" "$used_pct")
  if [ "$used_int" -ge 80 ]; then
    ctx_color="$RED"
  elif [ "$used_int" -ge 50 ]; then
    ctx_color="$YELLOW"
  else
    ctx_color="$GREEN"
  fi
  ctx_part=" ${ctx_color}ctx: ${used_int}% Used${RESET}"
fi

# --- ccusage spend line (background-update pattern) ---
# ccusage v18 scans all transcripts (~11s on large histories). We read the semaphore cache
# directly for instant display, then kick off ccusage in the background to refresh it.
# Strip the trailing "| 🧠 ..." segment since we trust Claude Code's ctx value on line 2.
ccusage_line=""
if command -v ccusage >/dev/null 2>&1; then
  _session_id=$(echo "$input" | jq -r '.session_id // empty')
  if [ -n "$_session_id" ]; then
    _tmpdir=$(python3 -c "import tempfile; print(tempfile.gettempdir())")
    _sem="$_tmpdir/ccusage-semaphore/${_session_id}.lock"
    _pid_alive="false"
    if [ -f "$_sem" ]; then
      _last_out=$(python3 -c "
import json, os
try:
    d = json.load(open('$_sem'))
    pid = d.get('pid')
    alive = False
    if pid:
        try: os.kill(pid, 0); alive = True
        except: pass
    print(d.get('lastOutput','') + '|||' + str(alive))
except:
    print('|||False')
" 2>/dev/null)
      _cached="${_last_out%|||*}"
      _pid_alive="${_last_out##*|||}"
      if [ -n "$_cached" ]; then
        ccusage_line=$(printf "%s" "$_cached" | sed 's/[[:space:]]*|[[:space:]]*🧠.*$//')
      fi
    fi
    # Kick off background refresh if no ccusage is currently running for this session
    if [ "$_pid_alive" != "True" ]; then
      (echo "$input" | ccusage statusline >/dev/null 2>&1) &
      disown $! 2>/dev/null
    fi
  fi
fi

# --- user@host (like p10k context) ---
user_host="{{ .chezmoi.username }}@{{ .chezmoi.hostname }}"

# --- vim mode (if active) ---
vim_part=""
vim_mode=$(echo "$input" | jq -r '.vim.mode // empty')
if [ -n "$vim_mode" ]; then
  if [ "$vim_mode" = "NORMAL" ]; then
    vim_part=" ${BLUE}[N]${RESET}"
  else
    vim_part=" ${GREEN}[I]${RESET}"
  fi
fi

# Pick line-1 content: ccusage if available, else model name, else nothing.
if [ -n "$ccusage_line" ]; then
  line1="$ccusage_line"
elif [ -n "$model" ]; then
  line1="${DIM}${model}${RESET}"
else
  line1=""
fi

# Render: line 1 (if non-empty) + newline + line 2.
if [ -n "$line1" ]; then
  printf "%s\n" "$line1"
fi
printf "%s%s%s%s%s%s  %s%s%s" \
  "$BLUE" "$short_cwd" "$RESET" \
  "$git_part" \
  "$ctx_part" \
  "$vim_part" \
  "$DIM" "$user_host" "$RESET"
